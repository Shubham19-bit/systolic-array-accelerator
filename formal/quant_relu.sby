# SymbiYosys formal verification for quant_relu (N = 1: every lane is the same logic)
#
#   cd formal
#   sby -f quant_relu.sby            # runs both tasks
#
# Properties live in rtl/quant_relu.sv inside `ifdef FORMAL: output stable under
# back-pressure, ReLU, identity in range, saturation of the lane function.

[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 10
cover: mode cover
cover: depth 12

[engines]
smtbmc

[script]
read_verilog -sv -formal -DFORMAL quant_relu.sv
chparam -set N 1 quant_relu
prep -top quant_relu

[files]
../rtl/quant_relu.sv
